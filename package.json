{
  "name": "belliedmonkeytranslator",
  "version": "1.6.8",
  "description": "Safari iOS browser extension for bilingual translation — fully open source, free, configurable LLM APIs",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "node test/run.js",
    "test:layout": "node test/layout/run-layout.js",
    "build": "node build.js",
    "clean": "rm -rf dist belliedmonkeytranslator.zip",
    "verify:ios": "node scripts/verify-ios-bundle.js",
    "verify:sim-audio": "node scripts/verify-sim-audio.js",
    "test:idb": "node scripts/verify-idb-upgrade.js",
    "app:sync": "node scripts/sync-app-assets.js",
    "test:app": "node scripts/verify-app-bundle.js",
    "test:app:china": "node scripts/verify-app-bundle.js --flavor china",
    "amo:check": "node scripts/amo-publish.js --check",
    "cws:check": "node scripts/cws-publish.js --check",
    "gh:check": "node scripts/gh-release.js",
    "perf:probe": "node scripts/perf-probe.js",
    "perf:status": "node scripts/perf-probe.js --status",
    "store:stats": "node scripts/store-stats.js",
    "test:smoke": "node scripts/verify-extension-smoke.js",
    "test:learn": "node scripts/verify-learn-flow.js",
    "test:speech": "node scripts/verify-speech-live.js",
    "test:sync": "node scripts/verify-sync-consistency.js",
    "test:setup-page": "node scripts/verify-setup-page.js",
    "test:onboard": "node scripts/verify-onboard.js dist && node scripts/verify-onboard.js dist-china"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
