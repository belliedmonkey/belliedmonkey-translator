# deploy/china/Caddyfile — 把 GoTrue 与 PostgREST 挂在同一个域名下。
#
# 路径必须与 Supabase 逐字相同（/auth/v1/* 与 /rest/v1/*）——
# 客户端拼地址的方式是 `MT_BACKEND.url + '/auth/v1'`（auth.js:48）与
# `+ '/rest/v1/'`（sync.js:26），只换 url 就该能跑。改路径 = 改客户端。

# ── 内部入口（不加密，只在 compose 网络里可达）──────────────────────────
#
# 存在的理由只有一个：`supabase/functions/bt-delete-account/index.ts` 是**共享文件**
# （国际版那边也在用），它写死了 `${SUPABASE_URL}/auth/v1/user` 这样的完整路径。
# 而 GoTrue 容器自己的路由是 `/user` —— 前缀是这一层加的。
#
# 所以给它一个**带前缀的内部地址**，而不是去改那个文件。改文件就会变成两份实现，
# 而这一整轮就是在消灭那种东西。
#
# 没有 ports: 映射，所以这个端口出不了 compose 网络。
:8081 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	# 验证码邮件模板（2026-09-22）。GoTrue 的 GOTRUE_MAILER_TEMPLATES_* 要的是**网址**，
	# 不是文件路径 —— 填路径会静默退回默认模板（点链接登录），而 App 接不了链接。
	# 模板原样取自东京项目（两份相同），见 deploy/china/otp.html。
	handle /templates/* {
		root * /srv
		file_server
	}
	# PostgREST 也要从内部可达（2026-10-01 补）：免费额度的两个函数（bt-grant / bt-grant-ledger）
	# 跑在 compose 里，它们的 `SUPABASE_URL` 指的就是这个内部入口，然后打 `/rest/v1/rpc/bt_grant_*`。
	# 没有这一块时它们拿到的是下面那句 `respond 404`（**空体 404**，看起来像「函数没实现」）——
	# 2026-10-01 实装时就是这么卡住的：外部路径 `https://<域名>/rest/v1/rpc/...` 是 200，
	# 而容器里同样的调用是 404，差别只在这一块。
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	respond 404
}

{$MT_DOMAIN} {
	# CORS：扩展页与宿主 App 都是从别的 origin 发过来的（App 的页面 origin 是 file://，请求头里 Origin: null）。
	# ⚠️ **必须排在所有路径 handle 之前。** handle / handle_path 是互斥的、先匹配先得：这一块原来排在后面，
	#    OPTIONS /auth/v1/* 于是被转给 GoTrue，而 GoTrue 回的 204 只有 Allow-Origin、没有 Allow-Headers ——
	#    浏览器拦下每一个带 apikey 头的登录请求（2026-09-22 模拟器 App 里 `Load failed`；curl 不做预检，
	#    所以服务器上五条链路「全通」的实测没看出来）。判据：见 README §4 那条 OPTIONS 回读。
	# 客户端实际会送的头只有这三个（auth.js:50、sync.js:31-38）——
	# 少一个就是全部请求被浏览器拦在发出去之前。
	# route：里面的块**按书写顺序**执行。不包的话 Caddy 按指令优先级排序，handle_path 永远先于 handle ——
	# 预检块写在最前面也会被路径块抢先（2026-09-22 第一次修只挪了位置，读回 OPTIONS 仍缺 Allow-Headers）。
	route {
		@cors_preflight method OPTIONS
		handle @cors_preflight {
			header {
				Access-Control-Allow-Origin "*"
				Access-Control-Allow-Methods "GET, POST, PATCH, DELETE, HEAD, OPTIONS"
				Access-Control-Allow-Headers "authorization, apikey, content-type, prefer"
				Access-Control-Max-Age "86400"
			}
			respond 204
		}
		# GoTrue 自己不带 /auth/v1 前缀，它的路由是 /otp、/verify、/token…
		# 所以这里要**剥掉**前缀再转发。
		handle_path /auth/v1/* {
			reverse_proxy auth:9999
		}

		# PostgREST 同理：它的路由是 /bt_chunks、/rpc/bt_usage。
		handle_path /rest/v1/* {
			reverse_proxy rest:3000
		}

		# 删号那个小服务（替代 Supabase 的 /functions/v1/bt-delete-account）。
		# 客户端调用点：auth.js:310。失败只降级为 partial 不抛，所以它不在
		# 关键路径上 —— 但没有它，用户删号时云端数据会留着。
		# 额度那两条**必须写在兜底之前**（Caddy 的 handle 按书写顺序匹配）：
		# 函数自己会把路径截到 `/bt-grant-ledger` 之后（见那个文件第 53 行），
		# 所以这里用 handle 而不是 handle_path，前缀留着也不影响。
		handle /functions/v1/bt-grant-ledger/* {
			reverse_proxy ledger:8000
		}
		handle /functions/v1/bt-grant {
			reverse_proxy grant:8000
		}
		handle_path /functions/v1/* {
			reverse_proxy fn:8000
		}

		# ── 模型下载中继（2026-10-05，#565）：客户端只见 api.belliedmonkey.com，不见真实托管 ──
		# 理由：反编译二进制能看到 device-models.config.js 的兜底 URL；把真实 GitHub/ModelScope
		# 地址写在那里等于把 CC-BY-NC 模型的来源暴露给任何人。这一块把它变成 302 —— 客户端
		# 拿到的是 Location 头，真实地址只存在于服务端（Caddyfile 也是部署侧，不进客户端包）。
		#
		# Caddy 的 redir 会发 302；客户端的下载器（MTBackgroundDownloader）跟重定向。
		# 真实地址也在 bt_model_sources 表里（model-sources.js 的优先路）；这一块是
		# 「服务器表 reachable + Caddy 也能直出」的双保险，不是唯一路。
		handle /models/vits-mms-tha.zip {
			redir https://github.com/belliedmonkey/belliedmonkey-translator/releases/download/device-models-2/vits-mms-tha.zip 302
		}
		handle /models/kokoro-zh-en.zip {
			redir https://www.modelscope.cn/models/belliedmonkey/belliedmonkey-device-models/resolve/master/kokoro-zh-en.zip 302
		}
		handle /models/sherpa-onnx-whisper-tiny.zip {
			redir https://www.modelscope.cn/models/belliedmonkey/belliedmonkey-device-models/resolve/master/sherpa-onnx-whisper-tiny.zip 302
		}
	}

	header {
		Access-Control-Allow-Origin "*"
		# PostgREST 的分页与 Prefer 回显要能被读到。
		Access-Control-Expose-Headers "content-range, content-location"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		# ⚠️ 不记请求体。语料是用户读过的句子 —— 把它写进访问日志，
		#    就等于在服务器上又存了一份没人管理生命周期的副本。
	}
}
