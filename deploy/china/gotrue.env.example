# deploy/china/gotrue.env.example — 复制成 gotrue.env 后填。
#
# 这里每一条都是客户端**已经在依赖**的行为，来源标在后面。不是调优项 ——
# 配错了不会报错，会在某个用户身上变成一个说不清的故障。

# ── 基本 ─────────────────────────────────────────────────────────────────
GOTRUE_SITE_URL=https://api.belliedmonkey.com
# App 的系统鉴权会话回跳（与东京项目的 uri_allow_list 同一项）。
GOTRUE_URI_ALLOW_LIST=belliedmonkeycn://auth
# GoTrue v2 的必填项（2026-09-22 首次实跑时 fatal：required key API_EXTERNAL_URL missing value）。
# 它是对外可见的 auth 根地址 —— 验证邮件与 OAuth 回跳按它拼。
API_EXTERNAL_URL=https://api.belliedmonkey.com/auth/v1
GOTRUE_API_HOST=0.0.0.0
PORT=9999

# 与 PostgREST 的 PGRST_JWT_SECRET **逐字相同**。生成：openssl rand -base64 48
# 不同的话：登录成功、同步全部 401 —— 两个症状看起来毫无关系。
GOTRUE_JWT_SECRET=
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
# 客户端 sessionFrom() 只读 access_token / refresh_token / expires_in /
# user.{email,phone,id}（auth.js:156-171）。aud 不匹配会让 PostgREST 拒掉 token。
GOTRUE_JWT_AUD=authenticated

# ── 邮箱 OTP：两条最容易漏的 ───────────────────────────────────────────────
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false

# ⚠️ GoTrue 的默认是 **8**。而我们的界面在 11 门语言里都写着「6 位验证码」
#    （options.js:1450），schema 说明与 auth.js:10-15 的注释也都是 6。
#    不改：用户收到 8 位、界面说 6 位，输进去必然失败。
GOTRUE_MAILER_OTP_LENGTH=6

# ⚠️ **两个模板都要渲染 {{ .Token }}，不是一个。**
#    GoTrue 按「这个邮箱是不是新的」选模板：新用户走 confirmation，
#    老用户走 magic_link。只改一个 ⇒ **恰好一半的用户收到一个点不动的链接**
#    —— 而扩展里根本没有能接 redirect 的页面，链接形态在那边走不通。
#    （supabase/README.md:13-33 记的就是这个坑。）
# ⚠️ 这两个要的是**网址**，不是文件路径（填路径会静默退回默认模板）。由 Caddy 内部入口提供。
GOTRUE_MAILER_TEMPLATES_CONFIRMATION=http://proxy:8081/templates/otp.html
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=http://proxy:8081/templates/otp.html
# 主题与模板原样取自东京项目（2026-09-22 用户裁定「复用东京这一套」）。
GOTRUE_MAILER_SUBJECTS_CONFIRMATION=大肚猴翻译 · 登录验证码 / Your sign-in code
GOTRUE_MAILER_SUBJECTS_MAGIC_LINK=大肚猴翻译 · 登录验证码 / Your sign-in code
GOTRUE_MAILER_OTP_EXP=3600

# ── refresh token：不配会「随机登出」 ────────────────────────────────────
#
# auth.js:239-277 有一个单飞刷新锁，:257-260 明确**依赖 GoTrue 的 reuse 宽限窗口**
# 做一次重试 —— 两个标签页同时刷新时，后到的那个拿着已被轮换掉的 refresh token，
# 靠这个窗口才不会被判死。
#
# ROTATION 关掉 ⇒ 安全性下降；REUSE_INTERVAL 为 0 ⇒ **用户会被随机登出**，
# 而且是那种「偶尔发生、复现不了」的。两个必须一起配。
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10

# ── Apple 登录 ───────────────────────────────────────────────────────────
#
# App 侧走的是 POST /auth/v1/token?grant_type=id_token，body
# {provider:'apple', id_token, nonce}（auth.js:517、app/app.js:593）。
# 这条路**不需要 client secret** —— 服务端只要能拿 Apple 的公开 JWKS 验签。
# 所以境内服务器要能出网到 appleid.apple.com（这是唯一的出境依赖，且只是取公钥）。
GOTRUE_EXTERNAL_APPLE_ENABLED=true
# 下面这两个只有**扩展**那条路（/authorize + PKCE 回跳）才用得上。
# ⚠️ 回调地址登记在 Apple Services ID 控制台里，现在填的是
#    https://<project>.supabase.co/auth/v1/callback（docs/learning-design.md:1400-1407）
#    —— 换域名要去 Apple 后台改，那是外部配置不是代码。
# 原生那条路按 id_token 的 aud 核对 —— 必须含中国版 App 的 bundle id。
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=com.belliedmonkeytranslator.cn
# 中国版扩展没有登录（境内后端未就绪时 sync 关着），网页那条路不用；GoTrue 启用一家 provider 时要求
# secret 非空，填一个不可用的占位值。真要开网页流程时换成 scripts/apple-client-secret.js 生成的那个。
GOTRUE_EXTERNAL_APPLE_SECRET=unused-web-flow
GOTRUE_EXTERNAL_APPLE_REDIRECT_URI=https://api.belliedmonkey.com/auth/v1/callback

# Google 不配：中国版 providers 已被 build.js 限制为 ['apple']（大陆连不上）。

# ── 手机号：不开 ─────────────────────────────────────────────────────────
# 国内短信要企业主体（运营商要求，见 docs/china-backend-cost.md §15）。
# 2026-09-05 裁定：只做 Apple + 邮箱。
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_SMS_AUTOCONFIRM=false

# ── SMTP ─────────────────────────────────────────────────────────────────
#
# 🔴 **这是整条路上唯一可能真卡住的一环。**
#    腾讯云 SES 的官方文档**没有写**个人主体能否创建发信域名 —— 必须问客服。
#    不行的话备选：阿里云邮件推送 / 腾讯企业邮 SMTP / 境外事务邮件服务。
#    2026-09-22 先用 Gmail（587 实测通），同日用户裁定改走**境内邮箱**：Gmail 发信会把收件人邮箱
#    经 Google 的境外服务器转发 —— 那是一段出境，与「中国版全在境内」矛盾。
#    现用 QQ 邮箱 SMTP（个人即可开，授权码在 .local/keys.md 的 smtp_cn_pass）。smtp.vip.qq.com
#    不存在，@vip.qq.com 也走 smtp.qq.com。**发件地址必须是这个邮箱本身**，否则 QQ 拒发。
#    实测：外网 POST /otp 200（1.5 s）→ 1 秒内进 Gmail 收件箱（不是垃圾箱），6 位码 → /verify 拿到 session。
#    连通性每小时查一次（deploy/china/smtp-check.sh）。
GOTRUE_SMTP_HOST=smtp.qq.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=zcheung@vip.qq.com
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=zcheung@vip.qq.com
GOTRUE_SMTP_SENDER_NAME=大肚猴翻译 BelliedMonkey Translator
GOTRUE_SMTP_MAX_FREQUENCY=60s

# 限速。压在 20/小时：个人邮箱都有日发信上限（Gmail 500/天，QQ 邮箱更低且不公开）——
# 换成正经的事务邮件服务后可以放宽，但别去掉：这是防刷的第一道，也是唯一一道。
GOTRUE_RATE_LIMIT_EMAIL_SENT=20

# ── 关掉不需要的 ─────────────────────────────────────────────────────────
# 我们没有「注册」这个动作：/auth/v1/otp 带 create_user:true，登录即注册
# （auth.js:190 —— 没有密码可选，单独的注册步骤会是一个什么都不问的表单）。
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
